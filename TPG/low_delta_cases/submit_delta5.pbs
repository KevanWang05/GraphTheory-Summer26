#!/bin/bash
#PBS -N tpg_delta5
#PBS -l select=1:ncpus=1:mem=4gb
#PBS -l walltime=48:00:00
#PBS -j oe
#PBS -o tpg_search_5.log

# ──────────────────────────────────────────────────────────────────────
# tpg_delta5.pbs
# Standalone job (no array syntax) running tpg_cluster.py with MAX_DEGREE=5.
# Submit with: qsub tpg_delta5.pbs
# ──────────────────────────────────────────────────────────────────────

cd "$PBS_O_WORKDIR" || exit 1

# Activate environment if needed, e.g.:
# module load python/3.11
# source ~/envs/tpg/bin/activate

echo "Running tpg_cluster.py with MAX_DEGREE=5 on $(hostname)"
echo "Start time: $(date)"

python3 tpg_cluster.py 5

echo "End time: $(date)"
